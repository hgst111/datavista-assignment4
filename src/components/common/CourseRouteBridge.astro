---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import GlassPanel from '@/components/common/GlassPanel.astro';
import Button from '@/components/ui/Button.astro';
import Container from '@/components/ui/Container.astro';
import { withBase } from '@/lib/url';

interface Props {
  title: string;
  eyebrow: string;
  description: string;
  links: Array<{ label: string; href: string }>;
}

const { title, eyebrow, description, links } = Astro.props;
---

<BaseLayout title={title} description={description} noIndex={true}>
  <Header />
  <main id="main" tabindex="-1" data-pagefind-ignore>
    <section class="bridge">
      <Container size="md">
        <GlassPanel variant="solid" padding="xl" radius="xl" className="bridge__panel">
          <p class="bridge__eyebrow">{eyebrow}</p>
          <h1>{title}</h1>
          <p class="bridge__description">{description}</p>
          <div class="bridge__links">
            {links.map((link) => (
              <Button href={withBase(link.href)} variant="outline" size="lg">
                {link.label} <span aria-hidden="true">→</span>
              </Button>
            ))}
          </div>
        </GlassPanel>
      </Container>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .bridge {
    display: grid;
    min-height: min(68vh, 48rem);
    align-items: center;
    padding-block: var(--space-3xl);
  }

  .bridge__panel {
    text-align: center;
  }

  .bridge__eyebrow {
    margin: 0 0 var(--space-md);
    color: var(--color-accent-text);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 auto var(--space-lg);
    font-size: clamp(2.5rem, 7vw, 5rem);
    letter-spacing: -0.055em;
    line-height: 1;
  }

  .bridge__description {
    max-width: 42rem;
    margin: 0 auto;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .bridge__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
    margin-top: var(--space-2xl);
  }
</style>
