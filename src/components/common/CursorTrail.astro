<canvas class="cursor-trail" aria-hidden="true" inert hidden></canvas>

<style>
  .cursor-trail {
    position: fixed;
    inset: 0;
    z-index: 50;
    width: 100%;
    height: 100%;
    pointer-events: none;
    mix-blend-mode: overlay;
    opacity: 0.4;
  }

  .cursor-trail.is-entering {
    opacity: 0;
    animation: cursor-trail-enter 2s 1.6s ease-out forwards;
  }

  @keyframes cursor-trail-enter {
    to {
      opacity: 0.4;
    }
  }

  @media (prefers-reduced-motion: reduce), print {
    .cursor-trail {
      display: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  import { onLeave, onPage } from '@/lib/lifecycle';

  const pointerQuery = window.matchMedia('(hover: hover) and (pointer: fine)');
  const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
  let cleanup: (() => void) | undefined;
  let entrancePlayed = false;

  function startTrail(): void {
    cleanup?.();
    cleanup = undefined;

    const selectedCanvas =
      document.querySelector<HTMLCanvasElement>('.cursor-trail');
    if (!selectedCanvas) return;
    const canvas = selectedCanvas as HTMLCanvasElement;

    const selectedContext = canvas.getContext('2d');
    if (!selectedContext) return;
    const context = selectedContext as CanvasRenderingContext2D;

    const pointCount = 40;
    const params = {
      widthFactor: 0.45,
      mouseThreshold: 0.6,
      spring: 0.4,
      friction: 0.5,
    };
    const mouse = {
      x: window.innerWidth * 0.5,
      y: window.innerHeight * 0.5,
      targetX: 0,
      targetY: 0,
      moved: false,
    };
    const trail = Array.from({ length: pointCount }, () => ({
      x: mouse.x,
      y: mouse.y,
      vx: 0,
      vy: 0,
    }));

    let width = window.innerWidth;
    let height = window.innerHeight;
    let frame = 0;
    let running = false;
    let dpr = 1;

    function resizeCanvas(): void {
      width = window.innerWidth;
      height = window.innerHeight;
      // Cap the backing store on very dense screens to keep the full-screen
      // effect responsive while still accounting for device pixel ratio.
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      context.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function handlePointerMove(event: PointerEvent): void {
      if (event.pointerType === 'touch') return;
      mouse.moved = true;
      mouse.targetX = event.clientX;
      mouse.targetY = event.clientY;
    }

    function draw(timestamp: number): void {
      if (!running || document.hidden) {
        frame = 0;
        return;
      }

      // Preserve the source component's self-guided opening path until the
      // visitor first moves a mouse or pen.
      if (!mouse.moved) {
        mouse.targetX =
          (0.5 +
            0.3 * Math.cos(0.002 * timestamp) * Math.sin(0.005 * timestamp)) *
          width;
        mouse.targetY =
          (0.5 +
            0.2 * Math.cos(0.005 * timestamp) +
            0.1 * Math.cos(0.01 * timestamp)) *
          height;
      }

      context.clearRect(0, 0, width, height);
      context.beginPath();
      context.strokeStyle =
        getComputedStyle(document.documentElement)
          .getPropertyValue('--color-text')
          .trim() || '#111';
      context.globalAlpha =
        document.documentElement.dataset.theme === 'dark' ? 0.5 : 0.8;

      trail.forEach((point, index) => {
        if (index === 0) {
          point.x = mouse.x;
          point.y = mouse.y;
          context.moveTo(point.x, point.y);
          return;
        }

        const previous = trail[index - 1];
        point.vx += (previous.x - point.x) * params.spring;
        point.vy += (previous.y - point.y) * params.spring;
        point.vx *= params.friction;
        point.vy *= params.friction;
        point.x += point.vx;
        point.y += point.vy;
      });

      // Keep the original quadratic smoothing and progressively tapered
      // strokes from Nuxt Portfolio GSAP's CursorTrail.vue.
      for (let index = 1; index < trail.length - 1; index += 1) {
        const current = trail[index];
        const next = trail[index + 1];
        const midpointX = 0.5 * (current.x + next.x);
        const midpointY = 0.5 * (current.y + next.y);
        context.quadraticCurveTo(current.x, current.y, midpointX, midpointY);
        context.lineWidth = params.widthFactor * (pointCount - index);
        context.stroke();
      }

      const last = trail[trail.length - 1];
      context.lineTo(last.x, last.y);
      context.stroke();
      context.globalAlpha = 1;

      mouse.x += (mouse.targetX - mouse.x) * params.mouseThreshold;
      mouse.y += (mouse.targetY - mouse.y) * params.mouseThreshold;
      frame = window.requestAnimationFrame(draw);
    }

    function stop(): void {
      running = false;
      if (frame) window.cancelAnimationFrame(frame);
      frame = 0;
      context.clearRect(0, 0, width, height);
    }

    function syncEnabledState(): void {
      const enabled = pointerQuery.matches && !motionQuery.matches;
      canvas.hidden = !enabled;
      if (enabled) {
        if (!entrancePlayed) {
          canvas.classList.add('is-entering');
          entrancePlayed = true;
        }
        resizeCanvas();
        if (!running && !document.hidden) {
          running = true;
          frame = window.requestAnimationFrame(draw);
        }
      } else {
        canvas.classList.remove('is-entering');
        stop();
      }
    }

    function syncVisibility(): void {
      if (document.hidden) {
        stop();
      } else {
        syncEnabledState();
      }
    }

    window.addEventListener('pointermove', handlePointerMove, {
      passive: true,
    });
    window.addEventListener('resize', resizeCanvas, { passive: true });
    document.addEventListener('visibilitychange', syncVisibility);
    pointerQuery.addEventListener('change', syncEnabledState);
    motionQuery.addEventListener('change', syncEnabledState);
    syncEnabledState();

    cleanup = () => {
      stop();
      window.removeEventListener('pointermove', handlePointerMove);
      window.removeEventListener('resize', resizeCanvas);
      document.removeEventListener('visibilitychange', syncVisibility);
      pointerQuery.removeEventListener('change', syncEnabledState);
      motionQuery.removeEventListener('change', syncEnabledState);
      canvas.classList.remove('is-entering');
      canvas.hidden = true;
      context.globalAlpha = 1;
    };
  }

  onPage(startTrail);
  onLeave(() => {
    cleanup?.();
    cleanup = undefined;
  });
</script>
