---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import Container from '@/components/ui/Container.astro';
import GlassCard from '@/components/ui/GlassCard.astro';
import { withBase } from '@/lib/url';
---

<BaseLayout
  title="课程资料"
  description="《可视化导论》原始双语讲义、数据集、补充演示与源码快照。"
>
  <Header />
  <main id="main" tabindex="-1" class="resources-page">
    <Container size="xl">
      <header class="resources-heading">
        <p class="eyebrow">COURSE MATERIALS</p>
        <h1>课程资料</h1>
        <p>讲义、演示、CSV / JSON 数据和 supplementary 资源按原始仓库目录保留。</p>
      </header>

      <div class="resource-grid">
        <GlassCard href={withBase('/course-source/index.html')} padding="lg">
          <span class="resource-type">原版课程门户</span>
          <h2>课程门户与语言切换</h2>
          <p>打开原始门户。旧站中的章节导航、中文 / English 切换和课程页仍按原样提供。</p>
          <span class="resource-action">打开原版门户 ↗</span>
        </GlassCard>

        <GlassCard href={withBase('/course-source/lesson-01/lecture.md')} padding="lg">
          <span class="resource-type">五章双语讲义</span>
          <h2>原始讲义 Markdown</h2>
          <p>中文 lecture.md、英文 lecture-en.md 与每章的双语内容块 JSON 都在源码快照中。</p>
          <span class="resource-action">查看第一章讲义 ↗</span>
        </GlassCard>

        <GlassCard href={withBase('/course-source/supplementary/')} padding="lg">
          <span class="resource-type">Supplementary</span>
          <h2>补充演示集合</h2>
          <p>包含日历、色图、等值线、犯罪数据、学生数据、表格、树列表与相关工具脚本。</p>
          <span class="resource-action">打开补充资源 ↗</span>
        </GlassCard>

        <GlassCard
          href={withBase('/course-source/supplementary/5.%20%E4%BD%8E%E7%BB%B4%E6%95%B0%E6%8D%AE%E5%8F%AF%E8%A7%86%E5%8C%96.pdf')}
          padding="lg"
        >
          <span class="resource-type">PDF</span>
          <h2>低维数据可视化资料</h2>
          <p>保留原仓库中的《低维数据可视化》PDF 文件。</p>
          <span class="resource-action">打开 PDF ↗</span>
        </GlassCard>
      </div>

      <section class="resource-note glass-card">
        <h2>资源说明</h2>
        <ul>
          <li>原仓库固定提交为 <code>35a66ecb5e35e8c4f2c54a007cb6c590255b6f06</code>，108 个文件完整保存在正式项目的 <code>public/course-source/</code>。</li>
          <li>原版 D3 ES module 从 jsDelivr 加载；页面需通过本地 HTTP 开发服务器或静态托管访问，不能直接用 <code>file://</code> 打开。</li>
          <li>原课程仓库在该提交没有 LICENSE 文件，也没有在 README 声明许可证。</li>
        </ul>
      </section>
    </Container>
  </main>
  <Footer />
</BaseLayout>

<style>
  .resources-page {
    padding: var(--space-3xl) 0;
  }

  .resources-heading {
    max-width: 54rem;
    margin-bottom: var(--space-2xl);
  }

  .eyebrow,
  .resource-type {
    color: var(--color-accent-text);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .resources-heading h1 {
    margin: var(--space-sm) 0;
    font-size: var(--text-5xl);
  }

  .resources-heading p:last-child {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .resource-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .resource-grid :global(h2) {
    margin: var(--space-sm) 0;
    font-size: var(--text-xl);
  }

  .resource-grid :global(p) {
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .resource-action {
    color: var(--color-accent-text);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .resource-note {
    margin-top: var(--space-2xl);
    padding: var(--space-xl);
  }

  .resource-note li {
    margin-block: var(--space-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .resource-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
